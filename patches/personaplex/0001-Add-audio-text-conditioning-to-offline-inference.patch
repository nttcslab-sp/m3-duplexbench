+def encode_audio_tensor_to_codes(
+    audio: np.ndarray,
+    mimi: MimiModel,
+    frame_size: int,
+) -> torch.Tensor:
+    """Encode audio array into Mimi codes: [1, K, T]."""
+    codes = []
+    for encoded in lm_encode_from_sphn(
+        mimi,
+        lm_iterate_audio(
+            audio,
+            sample_interval_size=frame_size,
+            pad=True,
+        ),
+        max_batch=1,
+    ):
+        codes.append(encoded)
+
+    return torch.cat(codes, dim=-1)
+
+
+def apply_stereo_conditioning(
+    conditioning_user_wav: Optional[str],
+    conditioning_system_wav: Optional[str],
+    conditioning_system_txt: Optional[str],
+    user_mimi: MimiModel,
+    system_mimi: MimiModel,
+    lm_gen: LMGen,
+    text_tokenizer: sentencepiece.SentencePieceProcessor,
+    sample_rate: int,
+    frame_size: int,
+):
+    """Condition PersonaPlex on paired user/system audio."""
+    log("info", "start stereo conditioning")
+
+    user_audio = None
+    system_audio = None
+
+    if conditioning_user_wav is not None:
+        user_audio = lm_load_audio(conditioning_user_wav, sample_rate)
+
+    if conditioning_system_wav is not None:
+        system_audio = lm_load_audio(conditioning_system_wav, sample_rate)
+
+    if user_audio is not None and system_audio is not None:
+        num_samples = max(user_audio.shape[-1], system_audio.shape[-1])
+    elif user_audio is not None:
+        num_samples = user_audio.shape[-1]
+    else:
+        assert system_audio is not None
+        num_samples = system_audio.shape[-1]
+    duration = num_samples / sample_rate
+
+    if user_audio is None:
+        user_audio = np.zeros((1, num_samples), dtype=np.float32)
+    elif user_audio.shape[-1] < num_samples:
+        pad_len = num_samples - user_audio.shape[-1]
+        user_audio = np.pad(user_audio, ((0, 0), (0, pad_len)))
+
+    if system_audio is None:
+        system_audio = np.zeros((1, num_samples), dtype=np.float32)
+    elif system_audio.shape[-1] < num_samples:
+        pad_len = num_samples - system_audio.shape[-1]
+        system_audio = np.pad(system_audio, ((0, 0), (0, pad_len)))
+
+    user_codes = encode_audio_tensor_to_codes(
+        user_audio,
+        user_mimi,
+        frame_size,
+    )
+    system_codes = encode_audio_tensor_to_codes(
+        system_audio,
+        system_mimi,
+        frame_size,
+    )
+
+    # Text conditioning
+    text_tokens = None
+    if conditioning_system_txt is not None:
+        # prepare interleaver
+        interleaver = CustomInterleaver(
+            text_tokenizer,
+            system_mimi.frame_rate,
+            lm_gen.lm_model.text_padding_token_id,
+            lm_gen.lm_model.end_of_text_padding_id,
+            lm_gen.lm_model.zero_token_id,
+            keep_main_only=True,
+            resegment_by_tokenizer=False,
+            device='cpu',
+        )
+
+        # get aligns
+        aligns, chs = load_alignments(conditioning_system_txt)
+        assert len(chs) == 1 and chs[0] == '0', '--conditioning_txt must include only channel "0"'
+
+        # tokenize
+        text_tokens = interleaver.prepare_item(
+            aligns,
+            duration,
+            main_speaker="0"
+        )[0].squeeze()     # [L, ]-shaped torch.tensor
+
+    steps = min(user_codes.shape[-1], system_codes.shape[-1])
+    if text_tokens is not None:
+        steps = min(steps, text_tokens.shape[-1])
+
+    for t in range(steps):
+        user_step = user_codes[:, :, t : t + 1]
+        system_step = system_codes[:, :, t : t + 1]
+        text_step = None
+        if text_tokens is not None:
+            # text_step = text_tokens[:, 0, t]
+            text_step = text_tokens[t].unsqueeze(0)
+        tokens = lm_gen.step(
+            input_tokens=user_step,
+            moshi_tokens=system_step,
+            text_token=text_step,
+        )
+        _ = tokens
+
+    # Reset codec streaming states before the real input wav.
+    # Do not reset lm_gen, because that would erase the conditioning.
+    user_mimi.reset_streaming()
+    system_mimi.reset_streaming()
+
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+
+    log("info", f"duplex audio conditioning finished: {steps} steps")
+
+
