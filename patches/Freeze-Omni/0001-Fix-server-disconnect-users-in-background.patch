 # init connected users
 connected_users = {}
+disconnecting_users = set()
+
+
+def active_user_count():
+    return sum(
+        1 for sid in connected_users
+        if sid not in disconnecting_users
+    )
+
+
+def finish_disconnect(sid, timer, params, reason="disconnect"):
+    """Finish cleanup without blocking Socket.IO disconnect handler."""
+    try:
+        # Give send_pcm() a short chance to observe stop_pcm and exit.
+        time.sleep(0.5)
+
+        # Remove from connected_users before release()
+        if sid in connected_users and connected_users[sid][1] is params:
+            del connected_users[sid]
+            print(f"DEBUG: removed {sid} from connected_users")
+
+        disconnecting_users.discard(sid)
+
+        try:
+            print(f"DEBUG: release begin sid={sid}, reason={reason}")
+            params.release()
+            print(f"DEBUG: release end sid={sid}, reason={reason}")
+        except Exception as e:
+            print(f"WARNING: release failed sid={sid}: {repr(e)}")
+
+    finally:
+        disconnecting_users.discard(sid)
+        tts_pool.print_info()
+        pipeline_pool.print_info()
+        print(f"User {sid} disconnected")
+
+
+def start_disconnect_cleanup(sid, reason="disconnect", emit_timeout=False):
+    if sid not in connected_users:
+        return
+
+    timer, params = connected_users[sid]
+
+    disconnecting_users.add(sid)
+
+    try:
+        if emit_timeout:
+            socketio.emit('out_time', to=sid)
+    except Exception as e:
+        print(f"WARNING: failed to emit out_time sid={sid}: {repr(e)}")
+
+    try:
+        timer.cancel()
+    except Exception as e:
+        print(f"WARNING: timer cancel failed sid={sid}: {repr(e)}")
+
+    # Stop all worker loops explicitly.
+    params.stop_pcm = True
+    params.stop_generate = True
+    params.stop_tts = True
+
+    cleanup_thread = threading.Thread(
+        target=finish_disconnect,
+        args=(sid, timer, params, reason),
+        daemon=True,
+    )
+    cleanup_thread.start()
+
 
